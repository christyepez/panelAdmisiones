table FactMetaAdmision
	lineageTag: f0276bab-c62b-46f7-bc14-65f287b2857a

	measure 'Meta Oficial B26 Panel' = 2400
		formatString: #,0
		lineageTag: 434b656a-1f15-405c-b72c-33a332bea78c

	measure 'Meta Oferta Excel B26' = COALESCE(CALCULATE(SUM(FactMetaAdmision[Meta]), FactMetaAdmision[Periodo]="B26", FactMetaAdmision[NivelMeta]="DETALLE_FUENTE"),0)
		formatString: #,0
		lineageTag: 99afda95-bf44-49e0-85b1-a2a7f0880c00

	measure 'Meta Oficial Carrera B26' = COALESCE(CALCULATE(SUM(FactMetaAdmision[Meta]), FactMetaAdmision[Periodo]="B26", FactMetaAdmision[NivelMeta]="DETALLE_FUENTE"),0)
		formatString: #,0
		lineageTag: 9d77e190-5fc3-40e2-9729-ebfd45f7baef

	measure 'Meta Sede Excel B26' = COALESCE(CALCULATE(SUM(FactMetaAdmision[Meta]), FactMetaAdmision[Periodo]="B26", FactMetaAdmision[NivelMeta]="DETALLE_FUENTE", NOT ISBLANK(FactMetaAdmision[Sede])),0)
		formatString: #,0
		lineageTag: 698b5cb1-8b65-4aea-b146-5a5980047976

	measure 'Meta Modalidad Excel B26' = COALESCE(CALCULATE(SUM(FactMetaAdmision[Meta]), FactMetaAdmision[Periodo]="B26", FactMetaAdmision[NivelMeta]="DETALLE_FUENTE", NOT ISBLANK(FactMetaAdmision[Modalidad])),0)
		formatString: #,0
		lineageTag: 4f43d821-0fc6-487a-98d6-952f6d9c9fa4

	measure 'Meta B26 Base Contexto' = ```
				VAR HayOferta = ISFILTERED(DimOfertaAdm[Oferta])
				VAR HaySede = ISFILTERED(DimSedeAdm[Sede]) || ISINSCOPE(DimSedeAdm[Sede])
				VAR HayModalidad = ISFILTERED(DimModalidadAdm[Modalidad]) || ISINSCOPE(DimModalidadAdm[Modalidad])
				VAR HayCarrera = ISFILTERED(DimCarreraAdm[Carrera]) || ISINSCOPE(DimCarreraAdm[Carrera])
				VAR HayTipoCarrera = ISFILTERED(DimTipoCarrera[TipoCarrera]) || ISINSCOPE(DimTipoCarrera[TipoCarrera])
				VAR MetaTipo = CALCULATE(SUM(FactMetaAdmision[Meta]), FactMetaAdmision[Periodo]="B26", FactMetaAdmision[NivelMeta]="DETALLE_FUENTE")
				RETURN SWITCH(TRUE(), HayOferta, [Meta Oferta Excel B26], HayModalidad, [Meta Modalidad Excel B26], HaySede, [Meta Sede Excel B26], HayCarrera, [Meta Oficial Carrera B26], HayTipoCarrera, MetaTipo, [Meta Oficial B26 Panel])
			```
		formatString: #,0
		lineageTag: a4c6f31b-c07a-40a2-a748-5258332e8533

	measure 'Meta B26 Contexto Panel' = ```
				VAR BaseMeta = [Meta B26 Base Contexto]
				VAR FactorMes = IF([Hay Filtro Mes]=1, DIVIDE([Dias Objetivo B26 Contexto],[Dias Totales B26]), 1)
				RETURN BaseMeta * FactorMes
			```
		formatString: #,0
		lineageTag: 3e04af53-b5ed-4a45-a58f-4f86af864b8b

	measure 'Meta Excel B26 Matriz' = ```
				VAR MetaDetalle =
				    CALCULATE(
				        SUM(FactMetaAdmision[Meta]),
				        FactMetaAdmision[Periodo] = "B26",
				        FactMetaAdmision[NivelMeta] = "DETALLE_FUENTE"
				    )
				VAR MetaCarreraFuente =
				    CALCULATE(
				        SUM(FactMetaAdmision[Meta]),
				        FactMetaAdmision[Periodo] = "B26",
				        FactMetaAdmision[NivelMeta] = "DETALLE_FUENTE"
				    )
				VAR EnModalidad = ISINSCOPE(DimModalidadAdm[Modalidad])
				VAR EnSede = ISINSCOPE(DimSedeAdm[Sede])
				VAR EnCarrera = ISINSCOPE(DimCarreraAdm[Carrera])
				VAR HayOferta = ISFILTERED(DimOfertaAdm[Oferta])
				VAR HayFiltroDetalle =
				    ISFILTERED(DimCarreraAdm[Carrera]) ||
				    ISFILTERED(DimSedeAdm[Sede]) ||
				    ISFILTERED(DimModalidadAdm[Modalidad]) ||
				    HayOferta
				VAR V =
				    SWITCH(
				        TRUE(),
				        EnModalidad, MetaDetalle,
				        EnSede, MetaDetalle,
				        EnCarrera, IF(HayOferta, MetaDetalle, COALESCE(MetaDetalle, MetaCarreraFuente)),
				        HayFiltroDetalle, IF(HayOferta, MetaDetalle, COALESCE(MetaDetalle, MetaCarreraFuente)),
				        [Meta Oficial B26 Panel]
				    )
				RETURN IF(ISBLANK(V) || V = 0, BLANK(), V)
			```
		formatString: #,0
		lineageTag: 70237983-1d45-468e-9417-69d56df270e1

	measure 'Meta Oficial Carrera B26 Vis' = ```
				VAR V = [Meta Oficial Carrera B26]
				RETURN IF(ISBLANK(V) || V = 0, BLANK(), V)
			```
		formatString: #,0
		lineageTag: 9cb62522-54cf-4b25-a034-12b707662c6e

	measure 'Meta Sede Excel B26 Vis' = ```
				VAR V = [Meta Sede Excel B26]
				RETURN IF(ISBLANK(V) || V = 0, BLANK(), V)
			```
		formatString: #,0
		lineageTag: d381c39c-853b-4e69-906a-27d677166252

	measure 'Meta Modalidad Excel B26 Vis' = ```
				VAR V = [Meta Modalidad Excel B26]
				RETURN IF(ISBLANK(V) || V = 0, BLANK(), V)
			```
		formatString: #,0
		lineageTag: ecbd2e4e-9bb5-4769-aa69-56ebd83aa851

	measure 'Meta B26 Contexto Panel Vis' = ```
				VAR V = [Meta B26 Contexto Panel]
				RETURN IF(ISBLANK(V) || V = 0, BLANK(), V)
			```
		formatString: #,0
		lineageTag: 686f7685-9701-484d-bdf8-9113de9eb9c5

	measure 'Meta Excel B26 Matriz Vis' = ```
				VAR V = [Meta Excel B26 Matriz]
				RETURN IF(ISBLANK(V) || V = 0, BLANK(), V)
			```
		formatString: #,0
		lineageTag: 3fad6dc8-f179-4d34-9e2a-560b0980e5ef

