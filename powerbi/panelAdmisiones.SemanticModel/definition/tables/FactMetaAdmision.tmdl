	column OfertaB26 = COALESCE(LOOKUPVALUE(DimOfertaMap[OfertaB26], DimOfertaMap[Carrera], FactMetaAdmision[Carrera], DimOfertaMap[Sede], FactMetaAdmision[Sede], DimOfertaMap[Modalidad], FactMetaAdmision[Modalidad]), "NO")
		dataType: string
		lineageTag: a729ec8c-f4c0-478e-b0b5-8be574b6e4b6

	partition FactMetaAdmision = m
		mode: import
		source =
				let
				    S0 = FxLoadMetas(),
				    R = Table.SelectColumns(S0,{"Periodo","TipoPrograma","TipoCarrera","Carrera","Sede","Modalidad","ModalidadMeta","NivelMeta","Meta","MetaOficial","ArchivoOrigen"},MissingField.UseNull)
				in
				    R

