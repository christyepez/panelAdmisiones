table DimOfertaAdm
	lineageTag: 775175ac-5be9-496e-95f4-b67cb317b10f

	column Oferta
		dataType: string
		isKey
		lineageTag: 65402eaa-a620-4171-b0b2-4b6cd6bcc002
		sourceColumn: Oferta

	partition DimOfertaAdm = m
		mode: import
		source =
				let
				    Metas = FxLoadMetas(),
				    Keep = Table.SelectColumns(Metas,{"Oferta B26"},MissingField.UseNull),
				    Ren = Table.RenameColumns(Keep,{{"Oferta B26","Oferta"}},MissingField.Error),
				    Valid = Table.SelectRows(Ren, each [Oferta]<>null and Text.Trim(Text.From([Oferta]))<>""),
				    R = Table.Sort(Table.Distinct(Valid,{"Oferta"}),{{"Oferta",Order.Ascending}})
				in
				    R

