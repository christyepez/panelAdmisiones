table DimMesPeriodo
	column MesNumero
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: MesNumero

	column Mes
		dataType: string
		summarizeBy: none
		sourceColumn: Mes
		sortByColumn: MesNumero

	partition DimMesPeriodo = m
		mode: import
		source =
				let
				    T = #table(
				        type table [MesNumero = Int64.Type, Mes = text],
				        {{1,"ENE"},{2,"FEB"},{3,"MAR"},{4,"ABR"},{5,"MAY"},{6,"JUN"},{7,"JUL"},{8,"AGO"},{9,"SEP"},{10,"OCT"},{11,"NOV"},{12,"DIC"}}
				    )
				in
				    T
